<%# Override del título si quieres %>
    <% const title='Paquetes Turísticos' %>

        <div class="container py-5">
            <% if (successMessage) { %>
                <div class="alert alert-success alert-dismissible fade show">
                    <%= successMessage %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                    <div class="row">
                        <% paquetes.forEach(paquete=> { %>
                            <div class="col-12 mb-4">
                                <div class="card shadow-sm">
                                    <div class="row g-0">
                                        <!-- Imagen -->
                                        <div class="col-md-4">
                                            <% if (paquete.Imagenes && paquete.Imagenes.length> 0) {
                                                const primeraImagen = paquete.Imagenes[0];
                                                %>
                                                <img src="/uploads/<%= primeraImagen.ruta %>"
                                                    class="img-fluid rounded-start h-100 object-fit-cover"
                                                    alt="<%= paquete.nombre %>">
                                                <% } else { %>

                                                    <img src="/images/default-package.webp"
                                                        class="img-fluid rounded-start h-100 object-fit-cover"
                                                        alt="Imagen por defecto">
                                                    <% } %>
                                        </div>

                                        <!-- Contenido -->
                                        <div class="col-md-8">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start mb-3">
                                                    <h3 class="card-title h5">
                                                        <%= paquete.nombre %>
                                                            <% if (paquete.es_destacado) { %>
                                                                <span class="badge bg-warning text-dark ms-2">
                                                                    <i class="bi bi-star-fill"></i> Destacado
                                                                </span>
                                                                <% } %>
                                                    </h3>
                                                    <h4 class="text-success mb-0">
                                                        $<%= paquete.precio.toLocaleString() %>
                                                    </h4>
                                                </div>

                                                <p class="card-text text-muted">
                                                    <%= paquete.descripcion.substring(0, 150) %>...
                                                </p>

                                                <div class="d-flex gap-3 mb-3">
                                                    <% if (paquete.duracion_dias) { %>
                                                        <span class="text-muted">
                                                            <i class="bi bi-calendar"></i>
                                                            <strong>
                                                                <%= paquete.duracion_dias %> días
                                                            </strong>
                                                        </span>
                                                        <% } %>
                                                </div>

                                                <a href="/paquetes/<%= paquete.id_paquete %>" class="btn btn-primary">
                                                    <i class="bi bi-eye"></i> Ver Detalles
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                    </div>
        </div>