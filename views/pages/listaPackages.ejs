<main>
<%# Override del título si quieres %>
    <% const title='Paquetes Turísticos' %>

        <div class="container py-5">
            <% if (successMessage) { %>
                <div class="alert alert-success alert-dismissible fade show">
                    <%= successMessage %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                    <div class="row">
    <% paquetes.forEach(paquete => { %>
        <!-- Cambia col-12 por col-md-6 -->
        <div class="col-lg-6 mb-4">  <!-- ← Aquí está el cambio -->
            <div class="card h-100 p-1 hover-card">  <!-- h-100 para igualar altura -->
                <div class="row g-0 h-100">  <!-- h-100 aquí también -->
                    
                    <!-- Imagen -->
                    <div class="col-md-6">
                        
                             <% if (paquete.imagenes && paquete.imagenes.length > 0) {
                                                const primeraImagen = paquete.imagenes[0];
                                                %>
                            <img src="<%= primeraImagen.ruta %>"
                                class="img-fluid rounded h-100 object-fit-cover"
                                alt="<%= paquete.nombre %>">
                        <% } else { %>
                            <img src="/images/default-packages.webp"
                                class="img-fluid rounded h-100 object-fit-cover"
                                alt="Imagen por defecto">
                        <% } %>
                    </div>

                    <!-- Contenido -->
                    <div class="col-md-6">
                        <div class="card-body d-flex flex-column h-100 py-1 ">  <!-- flex-column h-100 -->
                            
                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h3 class="card-title h5 titulo-card fw-bold">
                                    <%= paquete.nombre %>
                                    <% if (paquete.es_destacado) { %>
                                        <span class="badge bg-warning text-dark ms-2">
                                            <i class="bi bi-star-fill"></i> Destacado
                                        </span>
                                    <% } %>
                                </h3>
                                
                            </div>

                            <!-- Descripción -->
                            <p class="card-text text-muted flex-grow-1">  <!-- flex-grow-1 -->
                                <%= paquete.descripcion.substring(0, 150) %>...
                            </p>

                            <!-- Duración -->
                            <div class="d-flex gap-3 mb-3">
                                <% if (paquete.duracion_dias) { %>
                                    <span class="text-muted">
                                        <i class="bi bi-calendar"></i>
                                        <strong>Duración: <%= paquete.duracion_dias %> días</strong>
                                    </span>
                                <% } %>
                            </div>

                            <div class="mt-auto">  <!-- Este div empuja todo hacia abajo -->
                                <!-- Precio -->
                                <div class="d-flex justify-content-end mb-3">
                                    <h4 class="text-dark mb-0">
                                        US$ <%= paquete.precio.toLocaleString() %>
                                    </h4>
                                </div>

                                <!-- Botón -->
                                <div class="d-flex gap-2">
                                <a href="/packages/details/<%= paquete.id_paquete %>" class="btn btn-primary w-50 boton-bg-bordo">
                                    <i class="bi bi-eye"></i> Ver Detalles
                                </a>
                                <a href="/packages/contact/<%= paquete.id_paquete %>" class="btn btn-primary w-50 boton-linea-bordo">
                                    <i class="bi bi-eye"></i> Consultar
                                </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% }); %>
</div>
        </div>
        </main>